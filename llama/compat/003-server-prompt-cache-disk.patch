+    void init_disk(const std::string & dir, const llama_context * ctx, bool has_mtmd, int32_t n_ctx_checkpoints, int32_t n_ubatch, bool needs_checkpoints);
+
+    bool disk_enabled() const {
+        return !disk_dir.empty();
+    }
+
+    // write the state data of an entry to its file and drop it from memory
+    bool spill(server_prompt_cache_state & state);
+
+    // erase an entry, together with its file
+    std::list<server_prompt_cache_state>::iterator erase(std::list<server_prompt_cache_state>::iterator it);
+
+private:
+    int32_t n_ctx_checkpoints = 0;
+    int32_t n_ubatch          = 0;
+    bool    needs_checkpoints = false;
+
+    // restore an entry from its file into the slot; the entry stays cached, the file is still valid
+    bool load_disk(std::list<server_prompt_cache_state>::iterator it, server_prompt & prompt, llama_context * ctx_tgt, llama_context * ctx_dft, int32_t id_slot);
 };
 

+//
+// server_prompt_cache disk mode
+//
+// file layout (native endianness, the files never leave the machine that wrote them):
+//   u32 magic, u32 version
+//   u64 n_tokens, i32 tokens[n_tokens]
+//   u32 n_checkpoints, per checkpoint: i64 n_tokens, i32 pos_min, i32 pos_max, buf tgt, buf dft, buf spec
+//   buf main, buf drft
+// where buf is a u64 size followed by that many bytes
+//
+
+static constexpr uint32_t PROMPT_DISK_MAGIC   = 0x4344504f; // "OPDC"
+static constexpr uint32_t PROMPT_DISK_VERSION = 1;
+
+static bool prompt_disk_read(std::ifstream & ifs, void * dst, size_t size) {
+    return size == 0 || (bool) ifs.read((char *) dst, size);
+}
+
+static bool prompt_disk_read_buf(std::ifstream & ifs, std::vector<uint8_t> & buf) {
+    uint64_t n = 0;
+    // 64 GiB cap, in case the size field itself is corrupted
+    if (!prompt_disk_read(ifs, &n, sizeof(n)) || n > (1ull << 36)) {
+        return false;
+    }
+    try {
+        buf.resize(n);
+    } catch (const std::bad_alloc &) {
+        return false;
+    }
+    return prompt_disk_read(ifs, buf.data(), n);
+}
+
+static void prompt_disk_write(std::ofstream & ofs, const void * src, size_t size) {
+    if (size > 0) {
+        ofs.write((const char *) src, size);
+    }
+}
+
+static void prompt_disk_write_buf(std::ofstream & ofs, const std::vector<uint8_t> & buf) {
+    const uint64_t n = buf.size();
+    prompt_disk_write(ofs, &n, sizeof(n));
+    prompt_disk_write(ofs, buf.data(), n);
+}
+
+// reads the header and the tokens, leaving the stream positioned at the checkpoints
+static bool prompt_disk_read_tokens(std::ifstream & ifs, llama_tokens & tokens) {
+    uint32_t magic   = 0;
+    uint32_t version = 0;
+    uint64_t n       = 0;
+    if (!prompt_disk_read(ifs, &magic, sizeof(magic)) || magic != PROMPT_DISK_MAGIC ||
+        !prompt_disk_read(ifs, &version, sizeof(version)) || version != PROMPT_DISK_VERSION ||
+        !prompt_disk_read(ifs, &n, sizeof(n)) || n == 0 || n > (1ull << 32)) {
+        return false;
+    }
+    tokens.resize(n);
+    return prompt_disk_read(ifs, tokens.data(), n * sizeof(llama_token));
+}
+
+static bool prompt_disk_read_payload(const std::string & path, std::list<common_prompt_checkpoint> & checkpoints, server_prompt_data & data) {
+    std::ifstream ifs(path, std::ios::binary);
+    llama_tokens tokens;
+    if (!ifs || !prompt_disk_read_tokens(ifs, tokens)) {
+        return false;
+    }
+
+    uint32_t count = 0;
+    if (!prompt_disk_read(ifs, &count, sizeof(count)) || count > 1024) {
+        return false;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+        common_prompt_checkpoint cur;
+        cur.id_task = -1;
+        if (!prompt_disk_read(ifs, &cur.n_tokens, sizeof(cur.n_tokens)) ||
+            !prompt_disk_read(ifs, &cur.pos_min,  sizeof(cur.pos_min)) ||
+            !prompt_disk_read(ifs, &cur.pos_max,  sizeof(cur.pos_max)) ||
+            !prompt_disk_read_buf(ifs, cur.data_tgt) ||
+            !prompt_disk_read_buf(ifs, cur.data_dft) ||
+            !prompt_disk_read_buf(ifs, cur.data_spec)) {
+            return false;
+        }
+        checkpoints.push_back(std::move(cur));
+    }
+
+    return prompt_disk_read_buf(ifs, data.main) && prompt_disk_read_buf(ifs, data.drft);
+}
+
+// note: server_tokens::get_tokens() asserts when a projector is loaded, even for a text-only prompt
+static bool prompt_has_media(const server_tokens & tokens) {
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        if (tokens[i] == LLAMA_TOKEN_NULL) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void server_prompt_cache::init_disk(const std::string & dir, const llama_context * ctx, bool has_mtmd, int32_t n_ctx_checkpoints, int32_t n_ubatch, bool needs_checkpoints) {
+    namespace fs = std::filesystem;
+
+    std::error_code ec;
+    fs::create_directories(fs::u8path(dir), ec);
+    if (ec) {
+        SRV_WRN("prompt cache: cannot create disk directory '%s': %s - disk mode disabled\n", dir.c_str(), ec.message().c_str());
+        return;
+    }
+
+    disk_dir = dir;
+    this->n_ctx_checkpoints = n_ctx_checkpoints;
+    this->n_ubatch          = std::max(n_ubatch, 0);
+    this->needs_checkpoints = needs_checkpoints;
+
+    // entries are only removed when a newer prompt contains them, never to make room
+    limit_size   = 0;
+    limit_tokens = 0;
+
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+
+    std::vector<std::pair<fs::file_time_type, fs::path>> files;
+    for (const auto & entry : fs::directory_iterator(fs::u8path(dir), ec)) {
+        if (!entry.is_regular_file()) {
+            continue;
+        }
+        const auto & p = entry.path();
+        if (p.extension() == ".tmp") {
+            // a write that did not finish, the process was killed during it
+            fs::remove(p, ec);
+            continue;
+        }
+        if (p.extension() == ".bin") {
+            files.emplace_back(entry.last_write_time(ec), p);
+        }
+    }
+    // oldest first, like the in-memory cache
+    std::sort(files.begin(), files.end());
+
+    for (const auto & [_, p] : files) {
+        std::ifstream ifs(p, std::ios::binary);
+        llama_tokens tokens;
+        bool ok = ifs && prompt_disk_read_tokens(ifs, tokens);
+        for (size_t i = 0; ok && i < tokens.size(); ++i) {
+            ok = tokens[i] >= 0 && tokens[i] < n_vocab;
+        }
+        ifs.close();
+
+        if (!ok) {
+            SRV_WRN("prompt cache: discarding unreadable entry '%s'\n", p.u8string().c_str());
+            fs::remove(p, ec);
+            continue;
+        }
+
+        states.push_back({
+            /*.prompt =*/ { server_tokens(tokens, has_mtmd), {} },
+            /*.data   =*/ {},
+            /*.path   =*/ p.u8string(),
+        });
+    }
+
+    SRV_INF("prompt cache: disk mode, %zu entries in '%s'\n", states.size(), dir.c_str());
+}
+
+bool server_prompt_cache::spill(server_prompt_cache_state & state) {
+    namespace fs = std::filesystem;
+
+    // alloc() refused prompts with media, so every entry is text tokens only
+    llama_tokens tokens(state.prompt.tokens.size());
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        tokens[i] = state.prompt.tokens[i];
+    }
+
+    // FNV-1a over the token ids names the entry
+    uint64_t hash = 0xcbf29ce484222325ull;
+    for (const llama_token t : tokens) {
+        hash = (hash ^ (uint32_t) t) * 0x100000001b3ull;
+    }
+
+    const std::string path = disk_dir + DIRECTORY_SEPARATOR + string_format("prompt-%016llx-%zu.bin", (unsigned long long) hash, tokens.size());
+    const std::string tmp  = path + ".tmp";
+
+    const int64_t t_start = ggml_time_us();
+
+    {
+        std::ofstream ofs(fs::u8path(tmp), std::ios::binary | std::ios::trunc);
+        if (!ofs) {
+            SRV_WRN("prompt cache: cannot write '%s'\n", tmp.c_str());
+            return false;
+        }
+
+        const uint32_t magic   = PROMPT_DISK_MAGIC;
+        const uint32_t version = PROMPT_DISK_VERSION;
+        const uint64_t n       = tokens.size();
+        prompt_disk_write(ofs, &magic,   sizeof(magic));
+        prompt_disk_write(ofs, &version, sizeof(version));
+        prompt_disk_write(ofs, &n,       sizeof(n));
+        prompt_disk_write(ofs, tokens.data(), n * sizeof(llama_token));
+
+        const uint32_t count = (uint32_t) state.prompt.checkpoints.size();
+        prompt_disk_write(ofs, &count, sizeof(count));
+        for (const auto & cur : state.prompt.checkpoints) {
+            prompt_disk_write(ofs, &cur.n_tokens, sizeof(cur.n_tokens));
+            prompt_disk_write(ofs, &cur.pos_min,  sizeof(cur.pos_min));
+            prompt_disk_write(ofs, &cur.pos_max,  sizeof(cur.pos_max));
+            prompt_disk_write_buf(ofs, cur.data_tgt);
+            prompt_disk_write_buf(ofs, cur.data_dft);
+            prompt_disk_write_buf(ofs, cur.data_spec);
+        }
+
+        prompt_disk_write_buf(ofs, state.data.main);
+        prompt_disk_write_buf(ofs, state.data.drft);
+
+        ofs.flush();
+        if (!ofs) {
+            ofs.close();
+            std::error_code ec;
+            fs::remove(fs::u8path(tmp), ec);
+            SRV_WRN("prompt cache: failed to write '%s'\n", tmp.c_str());
+            return false;
+        }
+    }
+
+    std::error_code ec;
+    fs::rename(fs::u8path(tmp), fs::u8path(path), ec);
+    if (ec) {
+        fs::remove(fs::u8path(tmp), ec);
+        SRV_WRN("prompt cache: cannot publish '%s'\n", path.c_str());
+        return false;
+    }
+
+    SRV_INF("prompt cache: wrote %zu tokens, %zu checkpoints, %.3f MiB to '%s' in %.2f ms\n",
+            tokens.size(), state.prompt.checkpoints.size(), state.size() / (1024.0 * 1024.0), path.c_str(),
+            (ggml_time_us() - t_start) / 1000.0);
+
+    state.path = path;
+    state.prompt.checkpoints.clear();
+    state.data = {};
+
+    return true;
+}
+
+std::list<server_prompt_cache_state>::iterator server_prompt_cache::erase(std::list<server_prompt_cache_state>::iterator it) {
+    if (!it->path.empty()) {
+        std::error_code ec;
+        std::filesystem::remove(std::filesystem::u8path(it->path), ec);
+        SRV_TRC(" - removed prompt cache file '%s'\n", it->path.c_str());
+    }
+    return states.erase(it);
+}
+
+bool server_prompt_cache::load_disk(std::list<server_prompt_cache_state>::iterator it, server_prompt & prompt, llama_context * ctx_tgt, llama_context * ctx_dft, int32_t id_slot) {
+    const int64_t t_start = ggml_time_us();
+
+    std::list<common_prompt_checkpoint> checkpoints;
+    server_prompt_data data;
+
+    bool ok = prompt_disk_read_payload(it->path, checkpoints, data);
+    if (!ok) {
+        SRV_WRN("prompt cache: '%s' is unreadable, discarding it\n", it->path.c_str());
+    } else if (!data.drft.empty() && !ctx_dft) {
+        SRV_WRN("prompt cache: '%s' holds a draft state but there is no draft model, discarding it\n", it->path.c_str());
+        ok = false;
+    } else if (llama_state_seq_set_data_ext(ctx_tgt, data.main.data(), data.main.size(), id_slot, 0) != data.main.size()) {
+        SRV_ERR("prompt cache: failed to restore state from '%s', discarding it\n", it->path.c_str());
+        ok = false;
+    } else if (!data.drft.empty() && llama_state_seq_set_data_ext(ctx_dft, data.drft.data(), data.drft.size(), id_slot, 0) != data.drft.size()) {
+        SRV_ERR("prompt cache: failed to restore draft state from '%s', discarding it\n", it->path.c_str());
+        ok = false;
+    }
+
+    if (!ok) {
+        // an entry that failed once will fail again
+        erase(it);
+        return false;
+    }
+
+    while (checkpoints.size() > (size_t) std::max(n_ctx_checkpoints, 0)) {
+        checkpoints.pop_front();
+    }
+
+    SRV_INF("prompt cache: restored %zu tokens, %zu checkpoints from '%s' in %.2f ms\n",
+            it->prompt.tokens.size(), checkpoints.size(), it->path.c_str(), (ggml_time_us() - t_start) / 1000.0);
+
+    prompt = { it->prompt.tokens.clone(), std::move(checkpoints) };
+
+    // the entry is kept: the slot starts out identical to it, and once the slot moves on the file
+    // still holds this prompt (or is removed by alloc() when a newer prompt contains it)
+    return true;
+}
